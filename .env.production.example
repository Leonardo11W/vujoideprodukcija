# Frezka Admin - Production .env
# Copy to .env on server and fill in values

APP_NAME=Frezka
APP_ENV=production
APP_DEBUG=false
APP_URL=https://vujoideprodukcija.vujo.software
MIX_ASSET_URL=https://vujoideprodukcija.vujo.software

# Generate with: php artisan key:generate
APP_KEY=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=frezka_prod
DB_USERNAME=
DB_PASSWORD=

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@vujo.software
MAIL_FROM_NAME="${APP_NAME}"
